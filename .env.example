# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Google Gemini AI (Optional - falls back to library tag search if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Note: Legacy API keys (anon, service_role) are disabled on Supabase.
# Do NOT place secret or service role keys in client-accessible environment files.
